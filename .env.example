# VEYRA CRM — environment template (committed; no real values)
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx           # SERVER ONLY — never NEXT_PUBLIC_
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# --- Gemini ---
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash-lite

# REMINDER: RLS is OFF on this project by decision. See CREDENTIALS.md before
# writing any data-access code.

# ── Product AI ──────────────────────────────────────────────────────────────
# AI_PROVIDER selects the product's AI backend: "anthropic" or "gemini".
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
